---
import { SUPPORT_LEVEL_META, type SupportLevel } from "../data/support-level";

interface Props {
  level: SupportLevel;
  size?: "sm" | "md";
}

// 各状态的展示样式（表现层私有，symbol/label 走共享常量）
const levelClass: Record<SupportLevel, string> = {
  full: "border-accent-green/40 text-accent-green",
  partial: "border-accent/50 text-accent",
  stub: "border-white/20 text-mid",
};

const { level, size = "md" } = Astro.props;
const m = SUPPORT_LEVEL_META[level];
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border font-mono",
    size === "sm" ? "px-2 py-0.5 text-[10px]" : "px-3 py-1 text-[11px]",
    levelClass[level],
  ]}
  title={m.label}
>
  <span aria-hidden="true">{m.symbol}</span>
  <span class="tracking-wider">{m.label}</span>
</span>
