---
interface Props {
  index: string;
  title: string;
  lead?: string;
  id?: string;
}
const { index, title, lead, id } = Astro.props;
---

<div id={id} class="reveal mb-10 scroll-mt-28 sm:mb-14">
  <div class="flex items-center gap-4">
    <span class="font-mono text-xs tracking-[0.25em] text-accent">
      {index}
    </span>
    <span class="h-px flex-1 bg-white/15 sm:max-w-24" aria-hidden="true"></span>
  </div>
  <h2 class="mt-4 font-display text-3xl font-bold leading-[1.15] tracking-tight text-paper sm:text-5xl">
    {title}
  </h2>
  {lead && (
    <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-mid sm:text-lg">
      {lead}
    </p>
  )}
</div>
