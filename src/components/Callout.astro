---
interface Props {
  type?: "info" | "warn" | "tip";
  title?: string;
}
const { type = "info", title } = Astro.props;

const styles = {
  info: "border-accent-blue/35 bg-accent-blue/8",
  warn: "border-accent/45 bg-accent/10",
  tip: "border-accent-green/40 bg-accent-green/8",
};
const icons = {
  info: "ℹ",
  warn: "⚠",
  tip: "✓",
};
const labels = { info: "说明", warn: "注意", tip: "提示" };
---

<aside class={`reveal my-8 rounded-xl border-l-[3px] border p-5 ${styles[type]}`}>
  <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-mid">
    {icons[type]} {title ?? labels[type]}
  </p>
  <div class="mt-2.5 text-sm leading-relaxed text-subtle">
    <slot />
  </div>
</aside>
