---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Callout from "../components/Callout.astro";

const available = [
  { title: "双路由器", desc: "App Router 与 Pages Router 的开发与生产构建", tags: ["App Router", "Pages Router"] },
  { title: "服务端能力", desc: "React Server Components、Server Actions、路由处理器与中间件", tags: ["RSC", "Actions", "中间件"] },
  { title: "输出形态", desc: "静态生成、ISR、output: \"export\"，以及 standalone Node.js 输出", tags: ["ISR", "导出", "Standalone"] },
  { title: "核心 API", desc: "核心 Next.js API 与模块，包括 next/link、next/image、next/navigation、next/headers、next/cache，以及 Metadata API", tags: ["next/*", "Metadata"] },
  { title: "Cloudflare Workers", desc: "Cloudflare Workers 部署，支持 bindings、缓存适配器与图片优化", tags: ["Workers", "Bindings", "KV"] },
  { title: "迁移工具", desc: "迁移工具，通过 vinext check、vinext init，以及 vinext 的 Agent Skill", tags: ["check", "init", "Skill"] },
];

const gaps = [  {
    title: "Cache Components 与 Partial Prerendering",
    desc: "\"use cache\" 已实现部分功能，但完整的 cacheComponents 行为仍不完整。缓存配置文件、标签、局部外壳（partial shells）、恢复行为、预取，以及一些开发/构建阶段的缓存语义，尚未在所有情况下与 Next.js 一致。",
    impact: "高",
  },
  {
    title: "构建期图片与字体优化",
    desc: "图片可以在 Cloudflare 上按请求实时优化，但 vinext 尚未复刻 Next.js 完整的构建期图片处理流水线。Google Fonts 从 CDN 加载，本地字体 CSS 在运行时注入，而非在构建时提取。",
    impact: "中",
  },
  {
    title: "App Router 开发环境下的原生模块",
    desc: "sharp、resvg、satori、lightningcss、@napi-rs/canvas 等包在 Vite 的 RSC 开发环境中可能会失败。生产构建对这些情况的支持比开发模式更完整。",
    impact: "中",
  },
  {
    title: "平台特定与高级 Next.js 行为",
    desc: "preferredRegion 路由配置会被忽略；runtime 不会决定路由在哪里运行（在 cacheComponents 之外，runtime = \"edge\" 的 App Router 页面永远不会被 ISR 缓存，这与 Next.js 一致）；部分近期引入或未文档化的 Next.js 行为可能尚未复刻。",
    impact: "低",
  },
];

const impactStyle: Record<string, string> = {
  高: "border-accent/50 text-accent",
  中: "border-accent-blue/50 text-accent-blue",
  低: "border-mid/40 text-mid",
};

// 有意为之的排除项：以后也不会支持
const excluded = [
  { title: "Vercel 特定特性", desc: "@vercel/og 边缘运行时、Vercel Analytics 集成、Vercel KV/Blob/Postgres bindings。请使用平台等价物。" },
  { title: "AMP", desc: "自 Next.js 13 起已废弃。useAmp() 返回 false。" },
  { title: "next export（旧版）", desc: "请改用配置中的 output: 'export'。" },
  { title: "Turbopack/webpack 配置", desc: "这套东西跑在 Vite 上。请使用 Vite 插件，而非 webpack loader/插件。" },
  { title: "next/jest", desc: "请使用 Vitest。" },
  { title: "create-next-app 脚手架", desc: "新 vinext 项目请使用 create-vinext-app。" },
  { title: "与未文档化行为的逐 bug 对齐", desc: "如果它不在 Next.js 文档里，我们大概率不会复刻它。" },
];
---

<BaseLayout title="项目状态" description="vinext 项目状态：目前可用的功能与正在解决的已知兼容性缺口。">
  <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
    <p class="reveal font-mono text-[11px] uppercase tracking-[0.3em] text-accent">项目状态</p>
    <h1 class="reveal mt-4 font-display text-4xl font-bold tracking-tight text-paper sm:text-6xl">
      进展与<span class="text-accent">缺口</span>
    </h1>
    <p class="reveal mt-6 max-w-[62ch] text-base leading-relaxed text-mid sm:text-lg">
      vinext 目前已经能够支撑相当一部分规模的 Next.js 应用，但它还不是每个应用或生产负载的即插即用替代品。
      请预期会出现兼容性缺口（尤其是较新的 App Router 特性），并在采用前结合你自己的应用进行评估。
    </p>

    <!-- 可用功能 -->
    <SectionHeading index="01" title="目前可用的功能" />

    <div class="grid gap-4 md:grid-cols-2">
      {available.map((item, i) => (
        <article
          class="reveal group rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-colors duration-300 hover:border-accent/40 hover:bg-white/[0.04]"
          style={`--reveal-delay:${(i % 2) * 90}ms`}
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-display text-lg font-semibold tracking-tight text-paper">{item.title}</h3>
            <span class="font-mono text-[10px] text-mid/50">/{String(i + 1).padStart(2, "0")}</span>
          </div>
          <p class="mt-2.5 text-sm leading-relaxed text-mid">{item.desc}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <span class="rounded-full border border-white/10 px-2.5 py-0.5 font-mono text-[10px] tracking-wider text-subtle">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- 已知缺口 -->
        <SectionHeading
          index="02"
          id="正在解决的已知缺口"
          title="正在解决的已知缺口"
      lead="这些是当前活跃的兼容性工作方向，并非永久性的排除项。"
    />

    <div class="space-y-4">
      {gaps.map((gap, i) => (
        <article
          class="reveal rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-white/20"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-display text-lg font-semibold tracking-tight text-paper">{gap.title}</h3>
            <span class={`rounded-full border px-3 py-1 font-mono text-[11px] tracking-wider ${impactStyle[gap.impact]}`}>
              影响 · {gap.impact}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-mid">{gap.desc}</p>
        </article>
      ))}
    </div>

    <Callout type="info" title="迁移前的检查">
      <p>
        在迁移前，请先对已有应用运行
        <code class="rounded bg-ink/80 px-1.5 py-0.5 font-mono text-[0.9em]">vinext check</code>。
        如果某个缺口未列于此，请查看
        <a class="link-underline text-accent" href="https://github.com/cloudflare/vinext/issues" target="_blank" rel="noreferrer">open issues</a>
        或提交一个聚焦的重现示例。完整的 API 覆盖清单见
        <a class="link-underline text-accent" href="/api/">API 覆盖</a> 页面。
      </p>
    </Callout>

    <!-- 有意排除 -->
    <SectionHeading
      index="03"
      id="有意排除"
      title="不支持的内容（且以后也不会支持）"
      lead="这些是有意为之的排除项。对于目前缺失但已在路线图上的内容，见上方的正在解决的已知缺口。"
    />

    <div class="grid gap-4 md:grid-cols-2">
      {excluded.map((item, i) => (
        <article
          class="reveal rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-white/20"
          style={`--reveal-delay:${(i % 2) * 80}ms`}
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-mono text-[14px] font-semibold tracking-tight text-paper">{item.title}</h3>
            <span class="shrink-0 font-mono text-[10px] tracking-[0.2em] text-mid/50">/{String(i + 1).padStart(2, "0")}</span>
          </div>
          <p class="mt-2.5 text-sm leading-relaxed text-mid">{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
